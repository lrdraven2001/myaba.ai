# ─────────────────────────────────────────────────────────────────────────────
# admin-console/.env.production — used by `vite build` for admin.myaba.ai
#
# Same Firebase web config as the main app (one identity pool, project myapaai).
# These values are NOT secrets (Firebase web config is public by design) —
# access to /api/platform is enforced server-side by PLATFORM_ADMIN_EMAILS.
# ─────────────────────────────────────────────────────────────────────────────

# Real auth — dev bypass MUST be off in production.
VITE_DEV_AUTH=false

VITE_FIREBASE_API_KEY=AIzaSyBPibEIGVOlHJYl-EhsvcboCRpzosbjNuI
VITE_FIREBASE_AUTH_DOMAIN=myapaai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=myapaai
VITE_FIREBASE_STORAGE_BUCKET=myapaai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=880194476469
VITE_FIREBASE_APP_ID=1:880194476469:web:7f388a87452667ac8a61fc
