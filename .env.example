# Copy to .env and fill in values before running docker compose up

# Required for AI generation
ANTHROPIC_API_KEY=sk-ant-xxx

# Required for production (leave blank for DEV_AUTH=true mode)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ACLX Gateway (leave ACLX_ENABLED=false if not deployed yet)
ACLX_GATEWAY_URL=http://aclx:8080
ACLX_ENABLED=false
