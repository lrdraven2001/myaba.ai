# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.production — used by `vite build` for the live app (app.myaba.ai)
#
# These values come from the Firebase Console once you register a Web App on the
# myapaai project:  Project settings → General → Your apps → Web app → SDK config.
# They are NOT secrets (the Firebase web config is public by design); access is
# controlled by Firestore rules + the backend, not by hiding these.
#
# Fill in the 6 VITE_FIREBASE_* values below, then `npm run build`.
# ─────────────────────────────────────────────────────────────────────────────

# Real auth — dev bypass MUST be off in production.
VITE_DEV_AUTH=false

# Leave the emulator URL UNSET in production (presence of this var routes auth to
# the local emulator). Do not add VITE_FIREBASE_AUTH_EMULATOR_URL here.

VITE_FIREBASE_API_KEY=AIzaSyBPibEIGVOlHJYl-EhsvcboCRpzosbjNuI
VITE_FIREBASE_AUTH_DOMAIN=myapaai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=myapaai
VITE_FIREBASE_STORAGE_BUCKET=myapaai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=880194476469
VITE_FIREBASE_APP_ID=1:880194476469:web:7f388a87452667ac8a61fc

# Google Drive Picker (drive.file scope — least-privilege, no app verification).
# Browser API key is origin-restricted; like the Firebase web config above,
# these are not secrets. Enables "Browse Google Drive" + Drive import.
VITE_GOOGLE_DRIVE_CLIENT_ID=880194476469-o0kh14n53q8rlhu2c27n4borsc6ms6ip.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_API_KEY=AIzaSyA2VieuQaYaldK_SA_TWc_T8I13FQRQTsc

# Long AI calls (chat, document generation) go direct to Cloud Run (300s) to
# bypass the ~60s Firebase Hosting proxy timeout. Other calls use the /api rewrite.
VITE_DIRECT_API_URL=https://myaba-api-wnvhcl6tqq-uc.a.run.app
