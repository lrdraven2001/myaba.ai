<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>ai.myaba</groupId>
    <artifactId>myaba-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>myaba-api</name>
    <description>MyABA.ai — AI-Powered ABA Clinical Documentation API</description>

    <properties>
        <java.version>21</java.version>
        <firebase-admin.version>9.9.0</firebase-admin.version>
        <!-- Override Spring Boot 3.5.3's managed Tomcat (10.1.42) up to the latest
             10.1.x patch — clears the embedded-Tomcat CVEs the OWASP scan flagged
             (CVE-2026-43512, CVE-2026-41293, CVE-2025-55754, …). Same 10.1.x line,
             so Spring Boot compatibility is unaffected. -->
        <tomcat.version>10.1.54</tomcat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Align the whole Google Cloud stack (storage, gRPC, netty, protobuf, gax)
                 to one current, mutually-compatible set. This overrides the older
                 netty/protobuf that firebase-admin + google-cloud-storage pulled in
                 transitively, clearing their CVEs in a single coordinated bump. -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>26.83.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- openhtmltopdf 1.0.10 pulls pdfbox/fontbox/xmpbox 2.0.24 transitively;
                 force the patched 2.0.x across all three (CVE-2026-23907, CVE-2026-33929). -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>2.0.36</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>fontbox</artifactId>
                <version>2.0.36</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>2.0.36</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Security (for filter chain, not full OAuth) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Firebase Admin SDK (Auth verification + Firestore) -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase-admin.version}</version>
        </dependency>

        <!-- Apache POI — Excel (.xlsx / .xls) parsing for OfficePuzzle imports -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- Bucket4j — in-process rate limiting (per-IP and per-user token buckets) -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- HTML/CSS → PDF rendering for the executed BAA document -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>
        <!-- PDF text extraction for uploaded documents. Version managed above in
             dependencyManagement (pdfbox/fontbox/xmpbox 2.0.36). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Google Cloud Storage — stores ORIGINAL uploaded files (extracted text
             stays in Firestore). Version managed by the libraries-bom import above. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>

        <!-- Cloud Translation (Advanced, v3) — layout-preserving document translation
             (docx/pdf → same format). Version managed by the libraries-bom import above. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-translate</artifactId>
        </dependency>

        <!-- Stripe — subscription billing (Checkout + Billing Portal + webhooks).
             Card data never touches our servers (hosted Checkout keeps us out of
             PCI scope). Disabled at runtime when STRIPE_SECRET_KEY is unset. -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>24.16.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <!-- Explicit version required in annotationProcessorPaths —
                                 Spring Boot's BOM manages this in <dependencies> but the
                                 processor path resolution in BuildKit doesn't inherit it. -->
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- OWASP Dependency-Check — scans transitive dependencies for CVEs.
                 Run with: mvn dependency-check:check
                 Fails the build if CVSS score >= 7.0 (High).
                 CI should run this on every merge to main. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <!-- Kept current (12.x) for NVD API v2 reliability and CVE-data freshness. -->
                <version>12.1.3</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFile>owasp-suppressions.xml</suppressionFile>
                    <!-- Disable the Sonatype OSS Index analyzer: it now returns 401
                         Unauthorized for anonymous requests (requires a Sonatype account
                         + token), which aborts the whole analysis. NVD is our primary,
                         authoritative CVE source; OSS Index is a supplementary lookup we
                         can re-enable later by supplying ossIndexUsername/ossIndexPassword. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- Layered jar for optimal Docker layer caching -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                    <!-- Local dev: activate 'local' profile so application-local.yml is loaded.
                         Production/Docker: override with -Dspring.profiles.active=prod or env var. -->
                    <profiles>
                        <profile>local</profile>
                    </profiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
