rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// myABA.ai Firestore Security Rules — BACKEND-ONLY
//
// The Spring Boot backend uses the Firebase Admin SDK, which BYPASSES these
// rules entirely (elevated service-account credentials). No client application
// touches Firestore directly: the app and the admin console talk exclusively to
// the REST API, and the Firestore Web SDK is not even bundled. Every read and
// write therefore flows through the backend, where the real authorization lives
// — per-record caseload / PHI ACLs, the permission engine, ACLX governance, and
// the audit trail.
//
// Accordingly, ALL direct client access is denied. This closes the gap where an
// authenticated user could use the Web SDK with their own token to read their
// org's data directly (chats, clients, PHI…), bypassing the backend's
// minimum-necessary ACL and the audit logging. Cross-tenant access and all
// writes were already blocked; this also removes the looser intra-org read path.
//
// NOTE: these rules govern the client SDK only. The Admin SDK (backend) and
// console/IAM access are unaffected — console reads are governed by IAM and the
// Firestore Data Access audit logs.
//
// If a client-side Firestore feature is ever introduced, add narrowly-scoped
// read rules for those specific paths here — matching the backend's per-record
// authorization. The prior org-scoped rules are in git history as a reference.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all direct client-SDK access. Backend (Admin SDK) bypasses this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
